{
  "name": "audiomatch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4171 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4171 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data": "python pipeline/build_data.py",
    "data:fetch": "python pipeline/fetch_data.py",
    "test:pipeline": "python -m pytest pipeline/tests -q",
    "media": "python scripts/make_hero.py",
    "evaluate:quiz": "node scripts/evaluate_quiz.mjs",
    "evaluate:data": "python pipeline/evaluate.py"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
